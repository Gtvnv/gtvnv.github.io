---
/**
 * Contact — e-mail grande (mailto:), telefone (tel:), botões de copiar com
 * feedback traduzido (idle/done embutidos em data-attributes p/ clipboard.ts),
 * e links sociais. Os links mailto:/tel: são o fallback do clipboard.
 */
import SectionHead from "./SectionHead.astro";

interface Props {
  index: string;
  title: string;
  email: string;
  phoneDirect: string;
  phoneDirectDial: string;
  phone: string;
  phoneDial: string;
  phoneLabels: { direct: string; business: string };
  social: { linkedin: string; github: string; whatsapp: string };
  copyEmail: { idle: string; done: string };
  copyPhone: { idle: string; done: string };
}

const {
  index,
  title,
  email,
  phoneDirect,
  phoneDirectDial,
  phone,
  phoneDial,
  phoneLabels,
  social,
  copyEmail,
  copyPhone,
} = Astro.props;

// Direto (pessoal) primeiro; comercial (da empresa) em seguida.
const phones = [
  { label: phoneLabels.direct, display: phoneDirect, dial: phoneDirectDial },
  { label: phoneLabels.business, display: phone, dial: phoneDial },
];
---

<section class="section contact-section" id="contato">
  <div class="container">
    <SectionHead index={index} title={title} centered />

    {/* Ação principal: e-mail em destaque, com o botão de copiar colado nele. */}
    <div class="contact-primary">
      <a class="contact-email" href={`mailto:${email}`}>{email}</a>
      <button
        class="copy-btn"
        type="button"
        data-copy-value={email}
        data-copy-idle={copyEmail.idle}
        data-copy-done={copyEmail.done}
      >
        {copyEmail.idle}
      </button>
    </div>

    {/* Ação secundária: telefones (direto e comercial), com rótulo e mais quietos. */}
    {
      phones.map((p) => (
        <div class="contact-secondary">
          <span class="contact-phone-label">{p.label}</span>
          <a class="contact-phone" href={`tel:${p.dial}`}>{p.display}</a>
          <button
            class="copy-btn"
            type="button"
            data-copy-value={p.display}
            data-copy-idle={copyPhone.idle}
            data-copy-done={copyPhone.done}
          >
            {copyPhone.idle}
          </button>
        </div>
      ))
    }

    <div class="contact-links">
      <a href={social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={social.github} target="_blank" rel="noopener">GitHub</a>
      <a href={social.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>
