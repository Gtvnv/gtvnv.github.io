---
/**
 * SectionHead — cabeçalho de seção da home: só o título.
 * `centered` usa a variante centralizada (formação/idiomas/contato).
 * `index` é aceito por compatibilidade com os componentes que ainda o passam,
 * mas não é mais renderizado (o índice mono "01 / Sobre" foi removido).
 */
interface Props {
  index?: string;
  title: string;
  centered?: boolean;
}

const { title, centered = false } = Astro.props;
---

<div class={`section-head${centered ? " section-head-centered" : ""}`}>
  <h2 class="section-title">{title}</h2>
</div>
