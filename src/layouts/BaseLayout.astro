---
import { ClientRouter } from "astro:transitions";
import {
  DEFAULT_LOCALE,
  type Locale,
  type TranslationKey,
} from "../i18n/locales";
import { withBase } from "../lib/assets";
import LavaBackground from "../components/LavaBackground.astro";
import SEO from "../components/SEO.astro";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  locale?: Locale;
  /** Página (home/zenithcode/project) usada por SEO para canonical/hreflang. */
  translationKey: TranslationKey;
  /** Sobreposição de title/description para páginas internas. */
  meta?: { title?: string; description?: string };
}

const {
  locale = DEFAULT_LOCALE,
  translationKey,
  meta,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    {/* SEO por locale: title/description/OG/Twitter/canonical/hreflang. */}
    <SEO locale={locale} translationKey={translationKey} meta={meta} />
    {/* Slot para metadados extra específicos de uma página, se necessário. */}
    <slot name="head" />
    <ClientRouter />
    {/* Scripts de interação registrados de forma idempotente em astro:page-load
        (sobrevivem às View Transitions). Cada init* checa prefers-reduced-motion
        por conta própria. São no-op nas páginas sem os elementos esperados. */}
    <script>
      import "../scripts/home.ts";
    </script>
  </head>
  <body>
    <LavaBackground />

    {/* Placeholder de header — SiteHeader chega na FEAT-003 */}
    <slot name="header" />

    <main>
      <slot />
    </main>

    {/* Placeholder de footer — SiteFooter chega na FEAT-003 */}
    <slot name="footer" />
  </body>
</html>
